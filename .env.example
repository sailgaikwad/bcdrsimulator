# Google Cloud Project Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file itself.

GCP_PROJECT_ID=bcdrsimulator-sail
GCP_REGION=us-central1

# Optional: BigQuery dataset for analytics export
BQ_DATASET=bcdr_analytics

# Optional: Cloud Storage bucket for file exports
GCS_BUCKET=bcdr-simulator-exports

# Application settings
BCDR_DB_PATH=data/bcdr_simulator.db
BCDR_LOG_LEVEL=INFO
